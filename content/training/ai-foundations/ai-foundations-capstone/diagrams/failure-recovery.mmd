flowchart TD
    A["Failure appears or recovery test begins"] --> B["Preserve failed or test output"]
    B --> C["Identify exact failure"]
    C --> D["Return to source and criteria"]
    D --> E["Clarify instruction or narrow task"]
    E --> F["Run revised workflow"]
    F --> G{"Verified and safe?"}
    G -->|Yes| H["Record recovery and proceed"]
    G -->|No| I["Stop or document tested recovery path"]
