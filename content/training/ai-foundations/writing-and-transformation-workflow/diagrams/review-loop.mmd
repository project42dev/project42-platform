flowchart TD
    A["Draft"] --> B["Meaning check"]
    B --> C["Evidence check"]
    C --> D["Voice check"]
    D --> E["Accessibility check"]
    E --> F["Disclosure check"]
    F --> G{"Issue found?"}
    G -->|No| H["Final acceptance review"]
    G -->|Yes| I["Classify the issue"]
    I --> J{"What needs fixing?"}
    J -->|Meaning or evidence| K["Rebuild from source and evidence table"]
    J -->|Voice or accessibility| L["Revise against brief and audience needs"]
    J -->|Disclosure| M["Apply accurate disclosure requirement"]
    K --> A
    L --> A
    M --> A

