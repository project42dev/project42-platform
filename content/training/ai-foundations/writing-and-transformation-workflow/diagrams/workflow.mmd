flowchart TD
    A["Writing request"] --> B["Create brief"]
    B --> C["Identify audience and purpose"]
    C --> D["Name approved source of truth"]
    D --> E["Define acceptance criteria"]
    E --> F["Extract supported points"]
    F --> G["Transform format, language, and structure"]
    G --> H["Review meaning, evidence, voice, accessibility, and disclosure"]
    H --> I{"All criteria pass?"}
    I -->|Yes| J["Approve and publish"]
    I -->|No| K["Classify issue and apply the appropriate fix"]
    K --> F