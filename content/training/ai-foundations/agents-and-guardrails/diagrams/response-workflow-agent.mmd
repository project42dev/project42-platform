flowchart TD
    A["User request"] --> B["Model response"]
    A --> C["Deterministic workflow"]
    A --> D["Agentic loop"]

    B --> B1["One input"]
    B1 --> B2["One generated response"]

    C --> C1["Predefined check"]
    C1 --> C2["Predefined branch"]
    C2 --> C3["Known next step"]

    D --> D1["Read current state"]
    D1 --> D2["Choose next step"]
    D2 --> D3["Use permitted capability"]
    D3 --> D4["Update state"]
    D4 --> D5{"Exit condition met?"}
    D5 -->|No| D1
    D5 -->|Yes| D6["Complete or hand off"]