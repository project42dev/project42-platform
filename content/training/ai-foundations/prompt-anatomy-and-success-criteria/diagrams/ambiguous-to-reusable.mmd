flowchart LR
    A["Ambiguous request"] --> B["Identify missing details"]
    B --> C["Identify recurring inputs"]
    C --> D["Define achievable purpose and audience"]
    D --> E["Add instructions and placeholders"]
    E --> F["Separate requirements from preferences"]
    F --> G["Specify deliverable"]
    G --> H["Add missing-information rule"]
    H --> I["Define success criteria"]
    I --> J["Reusable prompt template"]
    J --> K["Test with new inputs"]
    K --> L{"Works consistently?"}
    L -->|Yes| M["Use repeatedly"]
    L -->|No| B

