{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:project42:multi-agent-handoff-policy:1.0",
  "title":"Project 42 recipient policy",
  "type":"object",
  "additionalProperties":false,
  "required":["expectedRecipient","recipientAllowed","contextAllowlist","maxTurns","maxDepth"],
  "$defs":{"text":{"type":"string","minLength":1,"pattern":".*\\S.*"}},
  "properties":{"expectedRecipient":{"$ref":"#/$defs/text"},"recipientAllowed":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/text"}},"contextAllowlist":{"type":"array","uniqueItems":true,"items":{"enum":["goal","constraints","traceId","completedSideEffects","facts","artifacts"]}},"maxTurns":{"type":"integer","minimum":1},"maxDepth":{"type":"integer","minimum":0}}
}
