{
  "name": "operate-and-recover-agent-systems-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node test/run-tests.mjs",
    "test:output-contract": "node test/output-contract.mjs",
    "test:reference": "node test/run-tests.mjs reference",
    "demo": "node src/recover.mjs fixtures/incident.json fixtures/ledger.json .tmp/recovered-ledger.json",
    "demo:reference": "node reference/recover.reference.mjs fixtures/incident.json fixtures/ledger.json .tmp/reference-ledger.json",
    "variation": "node src/recover.mjs fixtures/incident-changed.json fixtures/ledger-changed.json .tmp/changed-ledger.json"
  }
}
