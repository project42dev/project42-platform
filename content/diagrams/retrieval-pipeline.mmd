flowchart LR
    subgraph PREP["Prepare the knowledge"]
        direction TB
        A["Source material"] --> B["Extract usable content"]
        B --> C["Create retrievable units"]
        C --> D["Keep source identity and location"]
        D --> E["Build a searchable index"]
    end

    subgraph RUN["Retrieve and answer"]
        direction TB
        Q["User question"] --> R["Retrieve candidate evidence"]
        R --> F{"Is the evidence relevant and sufficient?"}
        F -->|No| U["Report insufficient evidence<br/>or ask for clarification"]
        F -->|Yes| G["Assemble the evidence context"]
        G --> H["Compose an answer from the evidence"]
        H --> J{"Are the answer claims supported<br/>by the evidence?"}
        J -->|No| U
        J -->|Yes| K["Attach source references"]
        K --> L["Grounded answer"]
    end

    E --> R
