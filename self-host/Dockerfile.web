# The public web portal image.
#
# IMPORTANT: the build context for this file is a Project 42 FRONT-END
# repository -- one produced by `project42-portal create` -- not this
# repository. The platform ships the application under web/ and installs it
# into a front-end repository, which is where the Next.js toolchain, the
# configuration, the branding and the theme bundles live. This Dockerfile used
# to build /app/dist/portal here, the output of a static generator that has
# since been retired.
#
#   cd your-academy
#   docker build -f node_modules/@project42/platform/self-host/Dockerfile.web -t project42/web .
FROM node:22-alpine AS builder

WORKDIR /app
COPY package*.json ./
# postinstall materialises the front-end application from @project42/platform,
# so scripts must run here.
RUN npm ci

COPY . .
RUN npm run pages:build

# Stage 2: Production NGINX Server
FROM nginx:alpine AS runner

COPY --from=builder /app/dist/pages /usr/share/nginx/html
# The build context is a front-end repository, so this file arrives with the
# installed platform package rather than sitting at the context root.
COPY --from=builder /app/node_modules/@project42/platform/self-host/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
