{
  "$schema": "./compatibility.schema.json",
  "schemaVersion": 1,
  "release": "0.56.0",
  "supportLevel": "evaluation",
  "api": {
    "package": "@project42/platform",
    "version": "0.56.0",
    "image": "ghcr.io/project42dev/project42-platform-api:0.56.0",
    "healthPath": "/health",
    "runsAsNonRoot": true
  },
  "database": {
    "adapter": "postgresql",
    "supportedMajors": [17],
    "migrationHead": "005_learning_events.sql"
  },
  "identity": {
    "protocol": "oidc",
    "flow": "authorization-code-pkce",
    "requiredClaims": ["iss", "sub", "aud", "exp", "iat", "email_verified"],
    "referenceProvider": "keycloak",
    "referenceVersion": "26.7.0",
    "provisioning": {
      "contractVersion": "1.0",
      "supportedModes": [
        "api",
        "resumable-owner-gate",
        "preconfigured"
      ],
      "referenceAdapter": "keycloak-admin-rest",
      "referenceAdapterVersion": "1.0.0",
      "engineVersion": "1.0.0",
      "stateStoreContract": "compare-and-set",
      "authorityContinuation": "sha256-bound"
    }
  },
  "learn": {
    "minimumVersion": "0.3.1",
    "configurationContract": [
      "NEXT_PUBLIC_PROJECT42_API_ORIGIN",
      "NEXT_PUBLIC_PROJECT42_OIDC_AUTHORITY",
      "NEXT_PUBLIC_PROJECT42_OIDC_CLIENT_ID",
      "NEXT_PUBLIC_PROJECT42_OIDC_SCOPE"
    ]
  },
  "update": {
    "channel": "github-release",
    "automaticApply": false,
    "signature": "sigstore-keyless"
  }
}
