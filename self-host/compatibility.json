{
  "$schema": "./compatibility.schema.json",
  "schemaVersion": 1,
  "release": "0.76.0",
  "supportLevel": "evaluation",
  "api": {
    "package": "@project42/platform",
    "version": "0.76.0",
    "image": "ghcr.io/project42dev/project42-platform-api:0.76.0",
    "healthPath": "/health",
    "runsAsNonRoot": true
  },
  "database": {
    "adapter": "postgresql",
    "supportedMajors": [
      17
    ],
    "migrationHead": "013_account_notification_outbox.sql",
    "learningRecords": {
      "selectionVariable": "LEARNING_RECORD_ADAPTER",
      "contractVersion": "1.1",
      "eventContractVersion": "1.1",
      "receiptContractVersion": "1.0",
      "recoveryContractVersion": "1.2",
      "semanticFingerprint": "learning-records/1.1;events/1.1;receipts/1.0;append-only;atomic-batch;optimistic-revision;authoritative-progress-import;verified-deletion-replay",
      "transactionMode": "atomic-sequential-batch"
    },
    "accountNotifications": {
      "contractVersion": "1.0",
      "adapterContract": "AccountNotificationAdapter",
      "adapterModuleVariable": "ACCOUNT_NOTIFICATION_ADAPTER_MODULE",
      "hostedServiceBinding": "ACCOUNT_NOTIFICATION_DELIVERY",
      "deliveryDefault": "disabled",
      "deliveryDeadlineMs": 5000,
      "minimumDeliveryDeadlineMs": 100,
      "maxDispatchItems": 10,
      "deadLetterRecovery": "linked-replacement",
      "states": [
        "pending",
        "delivering",
        "delivered",
        "retryable",
        "dead-letter"
      ],
      "maxAttempts": 5,
      "auditProvenance": [
        "owner",
        "system"
      ],
      "auditActorKindField": "metadata.actorKind"
    }
  },
  "identity": {
    "protocol": "oidc",
    "flow": "authorization-code-pkce",
    "requiredClaims": [
      "iss",
      "sub",
      "aud",
      "exp",
      "iat",
      "auth_time",
      "nonce",
      "email_verified"
    ],
    "referenceProvider": "keycloak",
    "referenceVersion": "26.7.0",
    "provisioning": {
      "contractVersion": "1.0",
      "supportedModes": [
        "api",
        "resumable-owner-gate",
        "preconfigured"
      ],
      "referenceAdapter": "keycloak-admin-rest",
      "referenceAdapterVersion": "1.0.0",
      "engineVersion": "1.0.0",
      "stateStoreContract": "compare-and-set",
      "authorityContinuation": "sha256-bound"
    }
  },
  "learn": {
    "availability": "released",
    "minimumVersion": "0.11.0",
    "sessionContract": "api-owned-http-only-cookie-v1",
    "configurationContract": [
      "NEXT_PUBLIC_PROJECT42_API_ORIGIN"
    ]
  },
  "update": {
    "channel": "github-release",
    "automaticApply": false,
    "signature": "sigstore-keyless"
  }
}
