PROJECT42_VERSION=0.96.0
PROJECT42_PUBLIC_URL=http://localhost:8787
PROJECT42_INSTALLATION_ID=example-installation
PROJECT42_ALLOWED_ORIGINS=http://localhost:3000
PROJECT42_DATABASE_PASSWORD=replace-with-a-long-random-password
PROJECT42_LEARNING_RECORD_ADAPTER=postgresql
# JSON array of explicit consents required on both accounts before merge.
PROJECT42_ACCOUNT_MERGE_REQUIRED_CONSENTS=[{"purpose":"learning-record","policyVersion":"2026-07-27"}]
# Optional local file URL, absolute path, or installed package exporting
# createAccountNotificationAdapter(). Keep empty to disable delivery.
PROJECT42_ACCOUNT_NOTIFICATION_ADAPTER_MODULE=
PROJECT42_IDENTITY_ADMIN_PASSWORD=replace-with-a-different-long-random-password
PROJECT42_OIDC_ISSUER=http://localhost:8080/realms/project42
PROJECT42_OIDC_AUDIENCE=project42-api
PROJECT42_OIDC_JWKS_URL=http://identity:8080/realms/project42/protocol/openid-connect/certs
# The HTTP evaluation profile is intentionally bearer-only. Set this to oidc
# only behind an HTTPS reverse proxy and provide every browser-session value.
PROJECT42_BROWSER_SESSION_MODE=disabled
PROJECT42_OIDC_AUTHORIZATION_ENDPOINT=
PROJECT42_OIDC_TOKEN_ENDPOINT=
PROJECT42_OIDC_CLIENT_ID=
PROJECT42_OIDC_CLIENT_SECRET=
PROJECT42_OIDC_REDIRECT_URI=
PROJECT42_OIDC_LOGOUT_ENDPOINT=
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
PROJECT42_SESSION_ENCRYPTION_KEY=
