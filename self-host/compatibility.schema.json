{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/schemas/self-host-compatibility-v1.json",
  "title": "Project 42 self-host compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "supportLevel",
    "api",
    "database",
    "identity",
    "learn",
    "update"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "supportLevel": { "enum": ["evaluation", "production"] },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "image", "healthPath", "runsAsNonRoot"],
      "properties": {
        "package": { "const": "@project42/platform" },
        "version": { "type": "string" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/project42dev/" },
        "healthPath": { "const": "/health" },
        "runsAsNonRoot": { "const": true }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "supportedMajors",
        "migrationHead",
        "learningRecords",
        "accountNotifications"
      ],
      "properties": {
        "adapter": { "const": "postgresql" },
        "supportedMajors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 14 }
        },
        "migrationHead": { "type": "string", "pattern": "^\\d+_[a-z0-9_-]+\\.sql$" },
        "learningRecords": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selectionVariable",
            "contractVersion",
            "eventContractVersion",
            "receiptContractVersion",
            "recoveryContractVersion",
            "semanticFingerprint",
            "transactionMode"
          ],
          "properties": {
            "selectionVariable": { "const": "LEARNING_RECORD_ADAPTER" },
            "contractVersion": { "const": "1.1" },
            "eventContractVersion": { "const": "1.1" },
            "receiptContractVersion": { "const": "1.0" },
            "recoveryContractVersion": { "const": "1.1" },
            "semanticFingerprint": {
              "const": "learning-records/1.1;events/1.1;receipts/1.0;append-only;atomic-batch;optimistic-revision;authoritative-progress-import;verified-deletion-replay"
            },
            "transactionMode": { "const": "atomic-sequential-batch" }
          }
        },
        "accountNotifications": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "adapterContract",
            "deliveryDefault",
            "states",
            "maxAttempts"
          ],
          "properties": {
            "contractVersion": { "const": "1.0" },
            "adapterContract": { "const": "AccountNotificationAdapter" },
            "deliveryDefault": { "const": "disabled" },
            "states": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "prefixItems": [
                { "const": "pending" },
                { "const": "delivering" },
                { "const": "delivered" },
                { "const": "retryable" },
                { "const": "dead-letter" }
              ],
              "items": false
            },
            "maxAttempts": { "const": 5 }
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "flow",
        "requiredClaims",
        "referenceProvider",
        "referenceVersion",
        "provisioning"
      ],
      "properties": {
        "protocol": { "const": "oidc" },
        "flow": { "const": "authorization-code-pkce" },
        "requiredClaims": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": { "type": "string" },
          "allOf": [
            { "contains": { "const": "iss" } },
            { "contains": { "const": "sub" } },
            { "contains": { "const": "aud" } },
            { "contains": { "const": "exp" } },
            { "contains": { "const": "iat" } },
            { "contains": { "const": "auth_time" } },
            { "contains": { "const": "nonce" } },
            { "contains": { "const": "email_verified" } }
          ]
        },
        "referenceProvider": { "const": "keycloak" },
        "referenceVersion": { "type": "string" },
        "provisioning": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contractVersion",
            "supportedModes",
            "referenceAdapter",
            "referenceAdapterVersion",
            "engineVersion",
            "stateStoreContract",
            "authorityContinuation"
          ],
          "properties": {
            "contractVersion": { "const": "1.0" },
            "supportedModes": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "api",
                  "resumable-owner-gate",
                  "preconfigured"
                ]
              },
              "allOf": [
                { "contains": { "const": "api" } },
                { "contains": { "const": "resumable-owner-gate" } },
                { "contains": { "const": "preconfigured" } }
              ]
            },
            "referenceAdapter": {
              "const": "keycloak-admin-rest"
            },
            "referenceAdapterVersion": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "engineVersion": {
              "const": "1.0.0"
            },
            "stateStoreContract": {
              "const": "compare-and-set"
            },
            "authorityContinuation": {
              "const": "sha256-bound"
            }
          }
        }
      }
    },
    "learn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availability",
        "minimumVersion",
        "sessionContract",
        "configurationContract"
      ],
      "properties": {
        "availability": { "enum": ["released", "candidate", "unreleased"] },
        "minimumVersion": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "sessionContract": {
          "const": "api-owned-http-only-cookie-v1"
        },
        "configurationContract": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NEXT_PUBLIC_PROJECT42_" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "availability": { "enum": ["released", "candidate"] } }
          },
          "then": {
            "properties": { "minimumVersion": { "type": "string" } }
          },
          "else": {
            "properties": { "minimumVersion": { "type": "null" } }
          }
        }
      ]
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "automaticApply", "signature"],
      "properties": {
        "channel": { "const": "github-release" },
        "automaticApply": { "const": false },
        "signature": { "const": "sigstore-keyless" }
      }
    }
  }
}
