{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/schemas/self-host-compatibility-v1.json",
  "title": "Project 42 self-host compatibility manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "release",
    "supportLevel",
    "api",
    "database",
    "identity",
    "learn",
    "components",
    "compatibility",
    "integrityPolicy",
    "releaseStatus",
    "releaseNotes",
    "update"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "release": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "supportLevel": { "enum": ["evaluation", "production"] },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "version", "image", "healthPath", "runsAsNonRoot"],
      "properties": {
        "package": { "const": "@project42/platform" },
        "version": { "type": "string" },
        "image": { "type": "string", "pattern": "^ghcr\\.io/project42dev/" },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "healthPath": { "const": "/health" },
        "runsAsNonRoot": { "const": true }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "supportedMajors", "migrationHead"],
      "properties": {
        "adapter": { "const": "postgresql" },
        "supportedMajors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 14 }
        },
        "migrationHead": { "type": "string", "pattern": "^\\d+_[a-z0-9_-]+\\.sql$" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "flow",
        "requiredClaims",
        "referenceProvider",
        "referenceVersion"
      ],
      "properties": {
        "protocol": { "const": "oidc" },
        "flow": { "const": "authorization-code-pkce" },
        "requiredClaims": {
          "type": "array",
          "minItems": 6,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "referenceProvider": { "const": "keycloak" },
        "referenceVersion": { "type": "string" }
      }
    },
    "learn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "image",
        "digest",
        "healthPath",
        "runsAsNonRoot",
        "configurationMode",
        "configurationContract"
      ],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/project42dev/project42-learn:"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "healthPath": { "const": "/health" },
        "runsAsNonRoot": { "const": true },
        "configurationMode": { "const": "build-time" },
        "configurationContract": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NEXT_PUBLIC_PROJECT42_" }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application",
        "schemas",
        "content",
        "trainingPackage",
        "adapters"
      ],
      "properties": {
        "application": { "$ref": "#/$defs/component" },
        "schemas": { "$ref": "#/$defs/component" },
        "content": { "$ref": "#/$defs/component" },
        "trainingPackage": { "$ref": "#/$defs/component" },
        "adapters": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/component" }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatible", "incompatible", "requiredMigrations"],
      "properties": {
        "compatible": {
          "type": "object",
          "additionalProperties": false,
          "required": ["learn", "node", "postgresql", "keycloak"],
          "properties": {
            "learn": { "type": "string", "minLength": 1 },
            "node": { "type": "string", "minLength": 1 },
            "postgresql": { "type": "string", "minLength": 1 },
            "keycloak": { "type": "string", "minLength": 1 }
          }
        },
        "incompatible": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "range", "reason"],
            "properties": {
              "component": { "type": "string", "minLength": 1 },
              "range": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 20 }
            }
          }
        },
        "requiredMigrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "sha256",
              "required",
              "appliesFrom"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "required": { "const": true },
              "appliesFrom": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "integrityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatureRequired",
        "provenanceRequired",
        "certificateIdentity",
        "certificateOidcIssuer",
        "trustedTransparencyLog",
        "allowedRunnerEnvironment",
        "rejectAltered",
        "rejectUnsigned",
        "rejectExpired",
        "rejectUntrusted"
      ],
      "properties": {
        "signatureRequired": { "const": true },
        "provenanceRequired": { "const": true },
        "certificateIdentity": {
          "type": "string",
          "pattern": "^https://github\\.com/project42dev/project42-platform/"
        },
        "certificateOidcIssuer": {
          "const": "https://token.actions.githubusercontent.com"
        },
        "trustedTransparencyLog": { "const": "https://rekor.sigstore.dev" },
        "allowedRunnerEnvironment": { "const": "github-hosted" },
        "rejectAltered": { "const": true },
        "rejectUnsigned": { "const": true },
        "rejectExpired": { "const": true },
        "rejectUntrusted": { "const": true }
      }
    },
    "releaseStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "issuedOn", "supersedes", "revocationAuthority"],
      "properties": {
        "state": { "enum": ["active", "revoked"] },
        "issuedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "supersedes": { "type": "string" },
        "revocationAuthority": { "type": "string", "pattern": "^https://" }
      }
    },
    "releaseNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release",
        "breakingChanges",
        "backup",
        "migrations",
        "limitations",
        "rollback"
      ],
      "properties": {
        "release": { "type": "string", "pattern": "^https://" },
        "breakingChanges": { "type": "string", "pattern": "^https://" },
        "backup": { "type": "string", "pattern": "^https://" },
        "migrations": { "type": "string", "pattern": "^https://" },
        "limitations": { "type": "string", "pattern": "^https://" },
        "rollback": { "type": "string", "pattern": "^https://" }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "automaticApply", "signature"],
      "properties": {
        "channel": { "const": "github-release" },
        "automaticApply": { "const": false },
        "signature": { "const": "sigstore-keyless" }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest", "artifacts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "canonicalization", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "canonicalization": { "const": "utf8-lf" },
            "value": { "$ref": "#/$defs/sha256" }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    }
  }
}
