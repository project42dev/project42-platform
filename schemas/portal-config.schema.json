{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/project42dev/project42-platform/main/schemas/portal-config.schema.json",
  "title": "Project 42 portal configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme",
    "availableThemes",
    "layout",
    "portal",
    "organization"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Theme bundle selected for every public-portal route."
    },
    "availableThemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "galleryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultPreset"
      ],
      "properties": {
        "defaultPreset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Installed layout bundle selected for the public portal."
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalOrigin",
        "adminOrigin",
        "legacyOrigins"
      ],
      "properties": {
        "canonicalOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "adminOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "legacyOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "apiOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Account and learning-record API origin. Optional; when absent the portal runs without an account service."
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagline",
        "supportUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "supportUrl": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamRepo": {
          "type": "string",
          "format": "uri"
        },
        "upstreamBranch": {
          "type": "string",
          "minLength": 1
        },
        "customContentDir": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths, under public/, to this deployment's own brand source artwork. Every key is optional and falls back to the shipped default filename.",
      "properties": {
        "wordmark": {
          "type": "string",
          "pattern": "^/"
        },
        "mark": {
          "type": "string",
          "pattern": "^/"
        },
        "markMono": {
          "type": "string",
          "pattern": "^/"
        },
        "markReversed": {
          "type": "string",
          "pattern": "^/"
        },
        "social": {
          "type": "string",
          "pattern": "^/"
        },
        "maskIcon": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
