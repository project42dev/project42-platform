{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/project42dev/project42-platform/main/schemas/portal-config.schema.json",
  "title": "Project 42 portal configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "theme",
    "availableThemes",
    "layout",
    "portal",
    "organization"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "theme": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Theme bundle selected for every public-portal route."
    },
    "availableThemes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "galleryUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultPreset"
      ],
      "properties": {
        "defaultPreset": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Installed layout bundle selected for the public portal."
        }
      }
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalOrigin",
        "adminOrigin",
        "legacyOrigins"
      ],
      "properties": {
        "canonicalOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "adminOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "legacyOrigins": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "apiOrigin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Account and learning-record API origin. Optional; when absent the portal runs without an account service."
        }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tagline",
        "supportUrl"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tagline": {
          "type": "string",
          "minLength": 1
        },
        "supportUrl": {
          "type": "string",
          "format": "uri-reference"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstreamRepo": {
          "type": "string",
          "format": "uri"
        },
        "upstreamBranch": {
          "type": "string",
          "minLength": 1
        },
        "customContentDir": {
          "type": "string",
          "minLength": 1,
          "description": "Path, relative to this repository, of the content repository whose merged catalogue this site renders. It must contain dist/catalog.json -- the inherited curriculum merged with this organisation's own modules, produced by `npm run content:build` there. Declaring it makes that catalogue the site's curriculum: `project42-portal materialise` installs it as lib/siteCatalog.generated.ts and fails the install if it is missing or malformed, rather than falling back to the platform's own. Omit it and the site renders the canonical Project 42 curriculum. PROJECT42_CONTENT_DIR overrides it, for CI where the checkout cannot be a sibling."
        },
        "instructorMedia": {
          "type": "object",
          "additionalProperties": false,
          "description": "Rendered instructor-led lesson media this deployment actually serves. The curriculum declares that a lesson was filmed; only the deployment knows whether its origin hosts the file.",
          "properties": {
            "baseUrl": {
              "type": "string",
              "pattern": "^/",
              "description": "Path under public/ that the media keys resolve against. Defaults to /preview/."
            },
            "availableKeys": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Media filenames present under baseUrl. A rendering whose key is absent is not offered."
            }
          }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "description": "Paths, under public/, to this deployment's own brand source artwork. Every key is optional and falls back to the shipped default filename.",
      "properties": {
        "wordmark": {
          "type": "string",
          "pattern": "^/"
        },
        "mark": {
          "type": "string",
          "pattern": "^/"
        },
        "markMono": {
          "type": "string",
          "pattern": "^/"
        },
        "markReversed": {
          "type": "string",
          "pattern": "^/"
        },
        "social": {
          "type": "string",
          "pattern": "^/"
        },
        "maskIcon": {
          "type": "string",
          "pattern": "^/"
        }
      }
    }
  }
}
