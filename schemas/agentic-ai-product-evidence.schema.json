{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/schemas/agentic-ai-product-evidence.schema.json",
  "title": "Project 42 agentic-AI product evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "asOf",
    "reviewBy",
    "owner",
    "scope",
    "evidencePolicy",
    "taxonomy",
    "sourceIndex",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "asOf": { "$ref": "#/$defs/date" },
    "reviewBy": { "$ref": "#/$defs/date" },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "scope": { "type": "string", "minLength": 80 },
    "evidencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unitOfClassification",
        "documentationOnly",
        "allowedEvidenceKinds",
        "unknownPolicy",
        "refreshPolicy"
      ],
      "properties": {
        "unitOfClassification": { "const": "version-scoped-product-experience" },
        "documentationOnly": { "const": true },
        "allowedEvidenceKinds": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceKind" },
          "allOf": [
            { "contains": { "const": "documented" } },
            { "contains": { "const": "tested" } },
            { "contains": { "const": "inference" } },
            { "contains": { "const": "unknown" } }
          ]
        },
        "unknownPolicy": { "type": "string", "minLength": 50 },
        "refreshPolicy": { "type": "string", "minLength": 50 }
      }
    },
    "taxonomy": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/taxonomyClass" }
    },
    "sourceIndex": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/source" }
    },
    "cases": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/productCase" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "evidenceKind": {
      "enum": ["documented", "tested", "inference", "unknown"]
    },
    "taxonomyId": {
      "enum": [
        "model",
        "chatbot",
        "assistant",
        "copilot",
        "deterministic-workflow",
        "agent",
        "agentic-system",
        "multi-agent-system"
      ]
    },
    "signal": {
      "enum": [
        "generates-output",
        "conversational-turns",
        "user-task-support",
        "human-led-control",
        "predefined-control-flow",
        "model-directed-next-step",
        "tool-use",
        "external-side-effects",
        "state",
        "feedback-loop",
        "goal-directed-run",
        "specialist-coordination",
        "handoff"
      ]
    },
    "taxonomyClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "definition",
        "requiredSignals",
        "boundary"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/taxonomyId" },
        "label": { "type": "string", "minLength": 3 },
        "definition": { "type": "string", "minLength": 50 },
        "requiredSignals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/signal" }
        },
        "boundary": { "type": "string", "minLength": 50 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "verifiedAt",
        "reviewBy",
        "owner",
        "trustTier"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": { "type": "string", "minLength": 5 },
        "url": { "type": "string", "pattern": "^https://" },
        "publisher": { "type": "string", "minLength": 2 },
        "verifiedAt": { "$ref": "#/$defs/date" },
        "reviewBy": { "$ref": "#/$defs/date" },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "trustTier": { "const": "primary" }
      }
    },
    "behaviorValue": {
      "enum": [
        "present",
        "absent",
        "optional",
        "external",
        "product-managed",
        "application-managed",
        "human-led",
        "unknown"
      ]
    },
    "observableBehavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goalDirectedRun",
        "modelDirectedNextStep",
        "toolAccess",
        "externalSideEffects",
        "state",
        "feedbackLoop",
        "multiActorCoordination",
        "humanControl"
      ],
      "properties": {
        "goalDirectedRun": { "$ref": "#/$defs/behaviorValue" },
        "modelDirectedNextStep": { "$ref": "#/$defs/behaviorValue" },
        "toolAccess": { "$ref": "#/$defs/behaviorValue" },
        "externalSideEffects": { "$ref": "#/$defs/behaviorValue" },
        "state": { "$ref": "#/$defs/behaviorValue" },
        "feedbackLoop": { "$ref": "#/$defs/behaviorValue" },
        "multiActorCoordination": { "$ref": "#/$defs/behaviorValue" },
        "humanControl": { "$ref": "#/$defs/behaviorValue" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "claim", "sourceIds"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": { "$ref": "#/$defs/evidenceKind" },
        "claim": { "type": "string", "minLength": 30 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    },
    "productCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "providerFamily",
        "experience",
        "surface",
        "observedAt",
        "reviewBy",
        "owner",
        "conclusionClass",
        "conclusionStatus",
        "conclusion",
        "observableBehavior",
        "claims",
        "boundaryNotes",
        "unknowns"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "providerFamily": {
          "enum": [
            "anthropic",
            "openai",
            "microsoft",
            "google",
            "xai",
            "moonshot-kimi",
            "deepseek",
            "open-weight"
          ]
        },
        "experience": { "type": "string", "minLength": 3 },
        "surface": {
          "enum": [
            "foundation-model",
            "api",
            "consumer-product",
            "developer-tool",
            "framework",
            "managed-service",
            "composed-system"
          ]
        },
        "observedAt": { "$ref": "#/$defs/date" },
        "reviewBy": { "$ref": "#/$defs/date" },
        "owner": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "conclusionClass": { "$ref": "#/$defs/taxonomyId" },
        "conclusionStatus": {
          "enum": ["documented", "qualified", "unknown"]
        },
        "conclusion": { "type": "string", "minLength": 80 },
        "observableBehavior": { "$ref": "#/$defs/observableBehavior" },
        "claims": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/claim" }
        },
        "boundaryNotes": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 30 }
        },
        "unknowns": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
