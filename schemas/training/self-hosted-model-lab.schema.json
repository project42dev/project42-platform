{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-42.dev/schemas/training/self-hosted-model-lab.schema.json",
  "title": "Project 42 portable self-hosted model lab package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "learningPathId",
    "implementation",
    "environment",
    "modelArtifact",
    "endpoint",
    "identityAndAccess",
    "evaluation",
    "load",
    "telemetry",
    "lifecycle",
    "recovery",
    "portability",
    "evidence",
    "safety",
    "approvals",
    "releaseStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "title": { "type": "string", "minLength": 8 },
    "learningPathId": { "const": "self-hosted-model-operations" },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter", "specificStepsSeparated"],
      "properties": {
        "kind": {
          "enum": [
            "portable",
            "homestead-foundry-reference",
            "alternative-reference"
          ]
        },
        "adapter": { "type": "string", "minLength": 3 },
        "specificStepsSeparated": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "configurationPath", "hardwareProfilePath"],
      "properties": {
        "shape": {
          "enum": [
            "workstation",
            "container-on-premises",
            "edge",
            "cloud-managed-compute"
          ]
        },
        "configurationPath": { "$ref": "#/$defs/safePath" },
        "hardwareProfilePath": { "$ref": "#/$defs/safePath" }
      }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "revision",
        "publisher",
        "sourceUrl",
        "licenseId",
        "licenseReviewPath",
        "provenancePath",
        "digest",
        "signatureStatus",
        "dependencyManifestPath",
        "scanEvidencePath"
      ],
      "properties": {
        "identity": { "type": "string", "minLength": 3 },
        "revision": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 2 },
        "sourceUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "licenseId": { "type": "string", "minLength": 2 },
        "licenseReviewPath": { "$ref": "#/$defs/safePath" },
        "provenancePath": { "$ref": "#/$defs/safePath" },
        "digest": { "$ref": "#/$defs/sha256" },
        "signatureStatus": {
          "enum": ["verified", "unavailable-documented", "failed"]
        },
        "dependencyManifestPath": { "$ref": "#/$defs/safePath" },
        "scanEvidencePath": { "$ref": "#/$defs/safePath" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "compatibilityProfile",
        "baseUrlTemplate",
        "healthPath",
        "readinessPath",
        "modelIdentityPath"
      ],
      "properties": {
        "protocol": { "enum": ["http", "https", "grpc"] },
        "compatibilityProfile": { "type": "string", "minLength": 3 },
        "baseUrlTemplate": {
          "type": "string",
          "pattern": "^(https?://(localhost|127\\.0\\.0\\.1)|\\{\\{[A-Z0-9_]+\\}\\})"
        },
        "healthPath": { "type": "string", "pattern": "^/" },
        "readinessPath": { "type": "string", "pattern": "^/" },
        "modelIdentityPath": { "type": "string", "pattern": "^/" }
      }
    },
    "identityAndAccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principalType",
        "authorizationPolicyPath",
        "secretSource",
        "networkExposure",
        "auditEvidencePath"
      ],
      "properties": {
        "principalType": { "type": "string", "minLength": 3 },
        "authorizationPolicyPath": { "$ref": "#/$defs/safePath" },
        "secretSource": { "type": "string", "minLength": 3 },
        "networkExposure": {
          "enum": ["loopback", "private-network", "controlled-public"]
        },
        "auditEvidencePath": { "$ref": "#/$defs/safePath" }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseSetPath", "configurationPath", "metrics", "passCriteria", "resultsPath"],
      "properties": {
        "caseSetPath": { "$ref": "#/$defs/safePath" },
        "configurationPath": { "$ref": "#/$defs/safePath" },
        "metrics": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2 }
        },
        "passCriteria": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 8 }
        },
        "resultsPath": { "$ref": "#/$defs/safePath" }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profilePath", "resultsPath", "capacityDecisionPath", "stopConditions"],
      "properties": {
        "profilePath": { "$ref": "#/$defs/safePath" },
        "resultsPath": { "$ref": "#/$defs/safePath" },
        "capacityDecisionPath": { "$ref": "#/$defs/safePath" },
        "stopConditions": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logsEvidencePath",
        "metricsEvidencePath",
        "tracesEvidencePath",
        "alertEvidencePath",
        "dataHandlingPath"
      ],
      "properties": {
        "logsEvidencePath": { "$ref": "#/$defs/safePath" },
        "metricsEvidencePath": { "$ref": "#/$defs/safePath" },
        "tracesEvidencePath": { "$ref": "#/$defs/safePath" },
        "alertEvidencePath": { "$ref": "#/$defs/safePath" },
        "dataHandlingPath": { "$ref": "#/$defs/safePath" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentVersion",
        "targetVersion",
        "compatibilityManifestPath",
        "backupEvidencePath",
        "updatePlanPath",
        "updateEvidencePath",
        "rollbackPlanPath",
        "rollbackEvidencePath"
      ],
      "properties": {
        "currentVersion": { "type": "string", "minLength": 1 },
        "targetVersion": { "type": "string", "minLength": 1 },
        "compatibilityManifestPath": { "$ref": "#/$defs/safePath" },
        "backupEvidencePath": { "$ref": "#/$defs/safePath" },
        "updatePlanPath": { "$ref": "#/$defs/safePath" },
        "updateEvidencePath": { "$ref": "#/$defs/safePath" },
        "rollbackPlanPath": { "$ref": "#/$defs/safePath" },
        "rollbackEvidencePath": { "$ref": "#/$defs/safePath" }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incidentScenario",
        "runbookPath",
        "recoveryObjective",
        "recoveryEvidencePath",
        "postIncidentPath"
      ],
      "properties": {
        "incidentScenario": { "type": "string", "minLength": 12 },
        "runbookPath": { "$ref": "#/$defs/safePath" },
        "recoveryObjective": { "type": "string", "minLength": 8 },
        "recoveryEvidencePath": { "$ref": "#/$defs/safePath" },
        "postIncidentPath": { "$ref": "#/$defs/safePath" }
      }
    },
    "portability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portableConcepts", "adapterSpecificStepsPath", "alternatives"],
      "properties": {
        "portableConcepts": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "adapterSpecificStepsPath": { "$ref": "#/$defs/safePath" },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adapter", "mappingPath"],
            "properties": {
              "adapter": { "type": "string", "minLength": 3 },
              "mappingPath": { "$ref": "#/$defs/safePath" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "digest"],
        "properties": {
          "kind": {
            "enum": [
              "artifact",
              "license-provenance",
              "endpoint",
              "evaluation",
              "load-capacity",
              "telemetry",
              "update",
              "rollback",
              "recovery"
            ]
          },
          "path": { "$ref": "#/$defs/safePath" },
          "digest": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prohibitedData", "stopConditions", "humanApprovalBoundaries"],
      "properties": {
        "prohibitedData": { "$ref": "#/$defs/nonEmptyStrings" },
        "stopConditions": { "$ref": "#/$defs/nonEmptyStrings" },
        "humanApprovalBoundaries": { "$ref": "#/$defs/nonEmptyStrings" }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "reviewer", "reviewedAt"],
        "properties": {
          "role": {
            "enum": [
              "editorial",
              "subject-matter",
              "accessibility",
              "safety",
              "lab-execution"
            ]
          },
          "reviewer": { "type": "string", "minLength": 3 },
          "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "releaseStatus": { "enum": ["draft", "approved"] }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 3,
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[a-zA-Z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    }
  }
}
