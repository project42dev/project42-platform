{
  "name": "{{NAME}}",
  "version": "0.1.0",
  "description": "{{ORGANIZATION}} — a Project 42 front end.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "{{ORIGIN}}",
  "repository": {
    "type": "git",
    "url": "https://example.org/{{NAME}}.git"
  },
  "bugs": {
    "url": "{{SUPPORT_URL}}"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "postinstall": "node node_modules/@project42/platform/bin/project42-portal.mjs materialise",
    "app:materialise": "node node_modules/@project42/platform/bin/project42-portal.mjs materialise",
    "doctor": "node node_modules/@project42/platform/bin/project42-portal.mjs doctor",
    "bootstrap": "npm run facts:generate && npm run brand:generate && npm run releases:generate",
    "themes:sync": "node scripts/sync-gallery-themes.mjs",
    "themes:check": "node scripts/sync-gallery-themes.mjs --check",
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "brand:check": "node --test tests/brand-source-integrity.test.mjs && node scripts/generate-brand-assets.mjs --check",
    "diagrams:generate": "node scripts/generate-diagrams.mjs",
    "diagrams:check": "node --test tests/diagram-integrity.test.mjs",
    "workflows:check": "node --test tests/workflow-governance.test.mjs",
    "governance:check": "node --test tests/governance-docs.test.mjs && node scripts/governance-docs-validation.mjs",
    "release:validate": "node --test tests/release-governance.test.mjs && node scripts/release-governance.mjs validate",
    "facts:generate": "node scripts/generate-release-facts.mjs",
    "facts:check": "node --test tests/release-facts-line-endings.test.mjs && node scripts/generate-release-facts.mjs --check",
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run facts:check",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "pages:export": "node scripts/export-github-pages.mjs --retire-admin-routes",
    "pages:build": "npm run build && npm run pages:export",
    "pages:serve": "node scripts/serve-github-pages.mjs",
    "links:check": "node scripts/link-integrity.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && npm run test:rendered && npm run test:links && npm run test:browser",
    "test:links": "node --test tests/link-integrity.test.mjs && npm run links:check",
    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "test:pages:artifact": "node --test tests/github-pages-export.test.mjs",
    "check": "npm run deferrals:check && npm run themes:check && npm run facts:check && npm run releases:check && npm run brand:check && npm run theme:boundary && npm run surface:check && npm run tokens:check && npm run pwa:check && npm run diagrams:check && npm run workflows:check && npm run governance:check && npm run release:validate && npm run lint && npm run typecheck && npm run build && npm run perf:check && npm run test:rendered && npm run test:links && npm run test:browser && npm run pages:export && npm run test:pages && npm run test:pages:artifact",
    "audit": "npm run audit:production",
    "audit:production": "npm audit --omit=dev --audit-level=critical",
    "verify": "npm run audit && npm run check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "releases:generate": "node scripts/generate-release-notes.mjs",
    "releases:check": "node scripts/generate-release-notes.mjs --check",
    "theme:boundary": "node scripts/theme-boundary-check.mjs",
    "surface:check": "node --test tests/surface-isolation.test.mjs",
    "tokens:check": "node --test tests/token-completeness.test.mjs",
    "pwa:check": "node --test tests/pwa.test.mjs",
    "perf:check": "node scripts/performance-budget.mjs",
    "deferrals:check": "node scripts/dated-deferrals.mjs"
  },
  "dependencies": {
    "@project42/platform": "github:project42dev/project42-platform#v{{PLATFORM_VERSION}}",
    "framer-motion": "^13.1.1",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.47.0",
    "@mermaid-js/mermaid-cli": "11.15.0",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "cross-env": "^10.1.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.1.8",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "postcss": "8.5.22",
    "sharp": "0.35.3",
    "playwright-core": "1.62.0",
    "nanoid": "^3.3.18"
  },
  "$allowScripts": "npm keys this by package NAME, not by the dependency spec. It was keyed by the spec, so npm covered nothing: it warned that @project42/platform's prepare script was unapproved on every install, and this repository's front end is BUILT by that prepare -- the day npm enforces rather than warns, an install would produce a package with no dist/ and the site would fail at its first import. esbuild, workerd, unrs-resolver and sharp fetch or compile their platform binaries in the same phase and the build needs all four.",
  "allowScripts": {
    "@project42/platform": true,
    "esbuild": true,
    "workerd": true,
    "unrs-resolver": true,
    "sharp": true,
    "puppeteer": false
  }
}
