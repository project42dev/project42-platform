{
  "id": "portal-default",
  "name": "Portal Default",
  "tagline": "The theme a fresh install renders with.",
  "description": "The product’s own stock theme: a white page, hairline rules, one slate-blue action colour, system type and no ornament. Not a Gallery theme and not a brand — the neutral ground a new deployment renders completely on before anyone chooses anything.",
  "author": "Project 42 Core Team",
  "version": "1.0.0",
  "polarity": "light",
  "font": "ui-sans-serif, system-ui, sans-serif",
  "assets": {
    "tokens": "tokens.css",
    "components": "portal.css",
    "mark": "mark.svg",
    "hero": "hero.png",
    "badges": {
      "foundations": "badges/badge-foundations.svg",
      "practitioner": "badges/badge-practitioner.svg",
      "agentic": "badges/badge-agentic.svg",
      "evidence": "badges/badge-evidence.svg"
    }
  },
  "tokens": {
    "--p42-bg": "#ffffff",
    "--p42-surface": "#f4f6f8",
    "--p42-surface-card": "#ffffff",
    "--p42-card-border": "rgba(15, 23, 42, 0.14)",
    "--p42-primary": "#1f3a5f",
    "--p42-primary-fg": "#ffffff",
    "--p42-accent": "#0f6f68",
    "--p42-accent-fg": "#ffffff",
    "--p42-secondary-btn-bg": "#ffffff",
    "--p42-secondary-btn-fg": "#1f3a5f",
    "--p42-secondary-btn-border": "rgba(31, 58, 95, 0.35)",
    "--p42-text-title": "#0f172a",
    "--p42-text-body": "#33415c",
    "--p42-text-muted": "#5a6779",
    "--p42-eyebrow": "#475569",
    "--p42-font-heading": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "--p42-surface-elevated": "#ffffff",
    "--p42-surface-code": "#f1f5f9",
    "--p42-border-soft": "rgba(15, 23, 42, 0.1)",
    "--p42-primary-hover": "#2b5183",
    "--p42-interactive-muted": "color-mix(in srgb, var(--p42-primary) 8%, transparent)",
    "--p42-hero-image": "url(\"/themes/portal-default/hero.png\")",
    "--p42-success-bg": "#e8f6ec",
    "--p42-success-border": "#9ac7a8",
    "--p42-success-fg": "#15602c",
    "--p42-warning-bg": "#fdf3da",
    "--p42-warning-border": "#d5b168",
    "--p42-warning-fg": "#6b4708",
    "--p42-danger-bg": "#fdeeed",
    "--p42-danger-border": "#dda6a2",
    "--p42-danger-fg": "#8a1c1c",
    "--p42-info-bg": "#e9f2fa",
    "--p42-info-border": "#9dbfd9",
    "--p42-info-fg": "#1c4c72",
    "--p42-overlay-scrim": "rgba(11, 18, 32, 0.96)",
    "--p42-overlay-fg": "#ffffff",
    "--p42-overlay-surface": "rgba(255, 255, 255, 0.12)",
    "--p42-overlay-border": "rgba(255, 255, 255, 0.24)",
    "--p42-shadow-color": "#0f172a",
    "--p42-shadow-card": "0 1px 2px rgba(15, 23, 42, 0.06)",
    "--p42-shadow-raised": "0 4px 12px rgba(15, 23, 42, 0.1)",
    "--p42-text-accent": "var(--p42-accent)",
    "--p42-text-emphasis": "var(--p42-primary)",
    "--p42-font-body": "ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "--p42-font-mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "--p42-font-mono-display": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "--p42-font-serif": "Georgia, \"Times New Roman\", serif",
    "--p42-surface-inverse": "#ffffff"
  },
  "subbrands": {
    "learn": "Learn",
    "guide": "Field Guide"
  }
}
