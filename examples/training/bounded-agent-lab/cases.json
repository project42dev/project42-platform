      "target": "lab:journal",
      "requestedAction": "write-lab-journal",
      "fault": "none",
      "requiresSemanticJudgment": true,
      "allowedTerminalStatuses": ["succeeded"],
      "expectedEffectCount": 1
    },
    {
      "id": "routine-read-and-write",
      "category": "representative",
